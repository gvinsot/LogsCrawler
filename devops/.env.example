# ==============================================================================
# PulsarCD - Environment Configuration
# Copy this file to .env and fill in your values before deploying
# ==============================================================================

# ==============================================================================
# Docker Registry Configuration
# ==============================================================================
# Your private Docker registry URL (without https://)
DOCKER_REGISTRY_URL=registry.example.com
# Registry credentials for push/pull operations
DOCKER_REGISTRY_USERNAME=myuser
DOCKER_REGISTRY_PASSWORD=mypassword

# ==============================================================================
# Traefik / Domain Configuration
# ==============================================================================
# Public hostname for the PulsarCD web interface
TRAEFIK_HOST=logs.example.com

# ==============================================================================
# Node Placement (Swarm hostnames)
# ==============================================================================
# Node where OpenSearch should be deployed
OPENSEARCH_NODE_HOSTNAME=node-1
# Node where the Backend should be deployed
BACKEND_NODE_HOSTNAME=node-2

# ==============================================================================
# SSH Configuration
# ==============================================================================
# Path to SSH keys on the host (mounted for SSH access to build/deploy)
SSH_KEYS_PATH=/home/myuser/.ssh

# --- SSH host key verification ---
# Verification is STRICT by default: a host missing from known_hosts aborts the
# connection instead of trusting whatever key answers. The SSH_KEYS_PATH mount
# above is read-only, so known_hosts lives on the read/write data volume.
PULSARCD_SSH_KNOWN_HOSTS=/data/known_hosts
# Bootstrap it once, FROM INSIDE the container (the `dockerhost` alias only
# resolves there, it is a host-gateway alias and can never appear in the node's
# own known_hosts):
#   docker exec $(docker ps -qf name=pulsarcd_swarm-manager) sh -c 'ssh-keyscan -p 22 dockerhost >> /data/known_hosts'
# Check the fingerprint out of band before trusting it.
# Alternative, unsafe on an untrusted network: trust the first key seen for any
# host that has no ssh_known_hosts_path of its own (a host configured with an
# explicit path is NOT affected -- give it ssh_known_hosts_path="accept-new").
#PULSARCD_SSH_ACCEPT_NEW_HOSTKEYS=false

# Build/deploy host only (build, deploy, .env editor). Defaults to "accept-new":
# the target is the container's own Docker host via the `dockerhost` alias, a
# name that cannot appear in a known_hosts prepared outside the container, so
# the key is pinned on first use and verified strictly afterwards. Set a file
# path here to verify strictly from the first connection.
#PULSARCD_GITHUB__SSH_KNOWN_HOSTS_PATH=accept-new

# ==============================================================================
# GitHub Integration (for Stacks tab)
# ==============================================================================
# GitHub Personal Access Token (with repo access)
PULSARCD_GITHUB__TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GitHub username
PULSARCD_GITHUB__USERNAME=myusername
# Git commit email
PULSARCD_GITHUB__USEREMAIL=myemail@example.com
# Path on host where repos are cloned
PULSARCD_GITHUB__REPOS_PATH=/home/myuser
# Path to deployment scripts
PULSARCD_GITHUB__REPOS_PATH=/home/myuser/repos
# SSH host for build/deploy commands (usually dockerhost for host-gateway)
PULSARCD_GITHUB__SSH_HOST=dockerhost
# SSH username for build/deploy commands
PULSARCD_GITHUB__SSH_USER=myuser
# Which repos to show in Stacks: "all" (default) or "starred"
#PULSARCD_GITHUB__REPOS_MODE=all

# ==============================================================================
# Authentication
# ==============================================================================
# Login credentials for the web interface.
# All three secrets below are REQUIRED by docker-compose.swarm.yml: the deploy
# aborts if any of them is unset or empty. Generate each one with:
#   openssl rand -base64 32
PULSARCD_AUTH__USERNAME=admin
# REQUIRED - set a strong password (>= 12 characters). Placeholder values such
# as "changeme" are refused by the backend, which then bootstraps the admin
# account with a random password printed once in the container logs.
PULSARCD_AUTH__PASSWORD=
# REQUIRED - JWT signing secret, minimum 32 characters: the backend refuses to
# start on a shorter or placeholder value. Forging a token with a guessed secret
# bypasses the password, the login rate limit and the role policy at once.
# If left empty the backend auto-generates one at every restart, which
# invalidates all sessions and breaks multi-replica deployments; pin it here.
#
# UPGRADING an existing deployment: devops/.env predates this variable and the
# compose file now uses the strict "${VAR:?}" form, so `docker stack deploy`
# fails until it is set. Add it (openssl rand -base64 32) rather than restoring
# a default -- everyone is logged out once, which is expected.
PULSARCD_AUTH__JWT_SECRET=
# Token expiry in hours
PULSARCD_AUTH__JWT_EXPIRY_HOURS=24
# REQUIRED - shared key for agent-to-backend API auth (agents must not run
# unauthenticated). Use the same value on the backend and on every agent.
# Minimum 32 characters: the backend refuses to start on a shorter value.
PULSARCD_AUTH__AGENT_KEY=

# OPTIONAL - per-agent keys, as a JSON object keyed by agent id. The Swarm agent
# service sets AGENT_AGENT_ID={{.Node.Hostname}}, so the keys are indexed by node
# hostname. With this set, a key is only accepted for the agent it was issued to,
# so one compromised agent cannot poll or answer for another.
# WARNING: the agent service currently distributes a single shared
# AGENT_AUTH_KEY to every node, so setting this without also giving each node its
# own key makes every agent fail authentication. Leave it empty to keep the
# shared-key behaviour.
#PULSARCD_AUTH__AGENT_KEYS={"node-1":"<32+ char key>","node-2":"<32+ char key>"}

# Set to true when the stack is published behind Traefik (the reference
# deployment): the per-address login rate limit reads X-Forwarded-For only when
# this is on. Traefik must overwrite the header (forwardedHeaders.trustedIPs),
# otherwise a client chooses its own rate-limit bucket. Leave unset/false when
# the API is reachable directly -- the header is forgeable.
PULSARCD_TRUST_PROXY_HEADERS=true

# ==============================================================================
# AI / vLLM Configuration
# ==============================================================================
# vLLM API URL (OpenAI-compatible endpoint)
VLLM_URL=http://vllm-dev-service:8000
# Model to use for AI features (HuggingFace model ID)
VLLM_MODEL=Qwen/Qwen3.5-122B-A10B
# Context window size in tokens (must match model's actual limit)
#PULSARCD_LLM__CONTEXT_TOKENS=128000
# Maximum output tokens per LLM response
#PULSARCD_LLM__MAX_OUTPUT_TOKENS=16384

# ==============================================================================
# Retention Configuration
# ==============================================================================
# Number of days to retain logs
LOG_RETENTION_DAYS=7

# ==============================================================================
# Tag Cleanup (optional, disabled by default)
# ==============================================================================
# Enable automatic cleanup of old git tags and Docker registry images
#PULSARCD_TAG_CLEANUP_ENABLED=false
# Dry-run mode: log what would be deleted without actually deleting (default: true)
#PULSARCD_TAG_CLEANUP_DRY_RUN=true
# Delete tags older than this many days (default: 30)
#PULSARCD_TAG_CLEANUP_MAX_AGE_DAYS=30
# How often to run the cleanup cycle, in hours (default: 24)
#PULSARCD_TAG_CLEANUP_INTERVAL_HOURS=24
# Always keep at least this many recent tags per repo (default: 5)
#PULSARCD_TAG_CLEANUP_KEEP_LATEST_N=5